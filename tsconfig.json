{
	"compilerOptions": {
		"lib": ["ES2022"],
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["src", "vitest.config.ts"]
}
